      <column caption='Origin IATA (calc)' datatype='string' name='[Calculation_3772035562864640]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [origin] = &quot;FRANKFURT/MAIN airport&quot; THEN &quot;FRA&quot;&#10;ELSEIF [origin] = &quot;AMSTERDAM/SCHIPHOL airport&quot; THEN &quot;AMS&quot;&#10;ELSEIF [origin] = &quot;ADOLFO SUAREZ MADRID-BARAJAS airport&quot; THEN &quot;MAD&quot;&#10;ELSEIF [origin] = &quot;PARIS-CHARLES DE GAULLE airport&quot; THEN &quot;CDG&quot;&#10;END' />
