              <calculation class='tableau' formula='{&#10;FIXED [Calculation_3772035562864640] :&#10;&#10;AVG(&#10;IF [year] &gt;= 2017 AND [year] &lt;= 2019&#10;THEN&#10;    { FIXED [Calculation_3772035562864640], [year] :&#10;        SUM([cargo])&#10;    }&#10;END&#10;)&#10;}' />
