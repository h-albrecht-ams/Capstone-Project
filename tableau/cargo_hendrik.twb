      <aliases enabled='yes' />
      <column caption='Cargo per Flight (Weighted)' datatype='real' name='[Calculation_1227421748445184]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF SUM([flights]) &gt; 0 THEN&#10;    SUM([cargo]) / SUM([flights])&#10;END' />
      </column>
      <column caption='Route' datatype='string' name='[Calculation_1227421756493825]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[origin] + &quot; → &quot; + [destination]' />
      </column>
      <column caption='Origin IATA (calc)' datatype='string' name='[Calculation_3772035562864640]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [origin] = &quot;FRANKFURT/MAIN airport&quot; THEN &quot;FRA&quot;&#10;ELSEIF [origin] = &quot;AMSTERDAM/SCHIPHOL airport&quot; THEN &quot;AMS&quot;&#10;ELSEIF [origin] = &quot;ADOLFO SUAREZ MADRID-BARAJAS airport&quot; THEN &quot;MAD&quot;&#10;ELSEIF [origin] = &quot;PARIS-CHARLES DE GAULLE airport&quot; THEN &quot;CDG&quot;&#10;END' />
      </column>
      <column caption='Baseline Cargo (LOD)' datatype='real' name='[Calculation_3772035568902147]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{&#10;FIXED [Calculation_3772035562864640] :&#10;&#10;AVG(&#10;IF [year] &gt;= 2017 AND [year] &lt;= 2019&#10;THEN&#10;    { FIXED [Calculation_3772035562864640], [year] :&#10;        SUM([cargo])&#10;    }&#10;END&#10;)&#10;}' />
      </column>
      <column caption='Annual Cargo' datatype='real' name='[Calculation_3772035570888708]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{&#10;FIXED [Calculation_3772035562864640], [year] :&#10;SUM([cargo])&#10;}' />
      </column>
      <column caption='Recovery Index' datatype='real' default-format='n#,##0.0;-#,##0.0' name='[Calculation_3772035577479173]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Calculation_3772035570888708] / [Calculation_3772035568902147] * 100' />
      </column>
      <column caption='Total Cargo KPI' datatype='real' default-format='n#,##0,,.0M;-#,##0,,.0M' name='[Calculation_3907825363558401]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(&#10;    IF [year] = [Parameters].[Parameter 4073164590706688] THEN&#10;        [cargo]&#10;    END&#10;)' />
      </column>
      <column caption='Total Flights KPI' datatype='integer' default-format='n#,##0,.00K;-#,##0,.00K' name='[Calculation_3907825363746818]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(&#10;    IF [year] = [Parameters].[Parameter 4073164590706688] THEN&#10;        [flights]&#10;    END&#10;)' />
      </column>
      <column caption='Cargo per Flight KPI' datatype='real' default-format='n#,##0.0;-#,##0.0' name='[Calculation_3907825364123651]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(&#10;    IF [year] = [Parameters].[Parameter 4073164590706688] THEN&#10;        [cargo]&#10;    END&#10;)&#10;/&#10;SUM(&#10;    IF [year] = [Parameters].[Parameter 4073164590706688] THEN&#10;        [flights]&#10;    END&#10;)' />
      </column>
      <column caption='Active Routes KPI' datatype='integer' name='[Calculation_3907825364328452]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD(&#10;    IF [year] = [Parameters].[Parameter 4073164590706688]&#10;       AND [cargo] &gt; 0&#10;    THEN [Calculation_1227421756493825]&#10;    END&#10;)' />
      </column>
      <column caption='Cargo 2020 (LOD)' datatype='real' name='[Calculation_4217887904415744]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{ FIXED [Calculation_3772035562864640] :&#10;    SUM(&#10;        IF [year] = 2020 THEN&#10;            [cargo]&#10;        END&#10;    )&#10;}' />
      </column>
      <column caption='Cargo Change vs Baseline (%)' datatype='real' default-format='n#,##0;-#,##0' name='[Calculation_4217887904899073]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='([Calculation_4217887904415744] - [Calculation_3772035568902147])&#10;/&#10;[Calculation_3772035568902147]&#10;* 100' />
      </column>
      <column caption='Selected Metric' datatype='real' name='[Calculation_4659342184181761]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [Parameters].[Parameter 4659342183792640] = &quot;Cargo&quot; THEN&#10;    SUM([cargo])&#10;ELSE&#10;    SUM([flights])&#10;END' />
      </column>
      <column caption='Axis Title' datatype='string' name='[Calculation_4659342186262530]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Parameters].[Parameter 4659342183792640] = &quot;Cargo&quot; THEN&#10;    &quot;Cargo (Million tonnes)&quot;&#10;ELSE&#10;    &quot;Number of Flights&quot;&#10;END' />
      </column>
      <column caption='Selected Geography' datatype='string' name='[Calculation_4689097727094785]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Parameters].[Parameter 4689097726820352] = &quot;Region&quot; THEN&#10;    [region]&#10;ELSE&#10;    [subregion]&#10;END' />
      </column>
      <column caption='Subregion Rank' datatype='integer' name='[Calculation_4863645446594560]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='RANK_DENSE(SUM([cargo]), &apos;desc&apos;)'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Region/Subregion Filter' datatype='boolean' name='[Calculation_4863645446868993]' role='measure' type='nominal'>
        <calculation class='tableau' formula='IF [Parameters].[Parameter 4689097726820352] = &quot;Region&quot; THEN&#10;    TRUE&#10;ELSE&#10;    RANK_DENSE(SUM([cargo]), &apos;desc&apos;) &lt;= 10&#10;END'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Geography Display Filter' datatype='boolean' name='[Calculation_4863645447475202]' role='measure' type='nominal'>
        <calculation class='tableau' formula='IF [Parameters].[Parameter 4689097726820352] = &quot;Region&quot; THEN&#10;    TRUE&#10;ELSE&#10;    RANK_DENSE(SUM([cargo]), &quot;desc&quot;) &lt;= 10&#10;END'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
