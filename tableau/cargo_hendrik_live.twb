      <aliases enabled='yes' />
      <column caption='Cargo per Flight (Weighted)' datatype='real' name='[Calculation_1227421748445184]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF SUM([flights]) &gt; 0 THEN&#10;    SUM([cargo]) / SUM([flights])&#10;END' />
      </column>
      <column caption='Route' datatype='string' name='[Calculation_1227421756493825]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[origin] + &quot; → &quot; + [destination]' />
      </column>
      <column caption='Origin IATA (calc)' datatype='string' name='[Calculation_3772035565420545]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [origin] = &quot;FRANKFURT/MAIN airport&quot; THEN &quot;FRA&quot;&#10;ELSEIF [origin] = &quot;AMSTERDAM/SCHIPHOL airport&quot; THEN &quot;AMS&quot;&#10;ELSEIF [origin] = &quot;ADOLFO SUAREZ MADRID-BARAJAS airport&quot; THEN &quot;MAD&quot;&#10;ELSEIF [origin] = &quot;PARIS-CHARLES DE GAULLE airport&quot; THEN &quot;CDG&quot;&#10;END' />
      </column>
      <column caption='Baseline Active Routes' datatype='string' name='[Calculation_3772035614195718]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [year] &gt;= 2017 AND [year] &lt;= 2019&#10;THEN [Calculation_1227421756493825]&#10;END' />
      </column>
      <column caption='Active Routes 2024' datatype='string' name='[Calculation_3772035614420999]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [year] = 2024&#10;THEN [Calculation_1227421756493825]&#10;END' />
      </column>
      <column caption='Annual Active Routes' datatype='integer' name='[Calculation_3772035614969864]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{&#10;    FIXED [Calculation_3772035565420545], [region], [year] :&#10;    COUNTD(&#10;        IF [cargo] &gt; 0&#10;        THEN [destination]&#10;        END&#10;    )&#10;}' />
      </column>
      <column caption='Baseline Active Routes Avg' datatype='real' default-format='n#,##0.0;-#,##0.0' name='[Calculation_3772035615125513]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{&#10;    FIXED [Calculation_3772035565420545], [region] :&#10;    AVG(&#10;        IF [year] &gt;= 2017 AND [year] &lt;= 2019&#10;        THEN [Calculation_3772035614969864]&#10;        END&#10;    )&#10;}' />
      </column>
      <column caption='Active Routes 2024 LOD' datatype='integer' default-format='n#,##0;-#,##0' name='[Calculation_3772035615272970]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{&#10;    FIXED [Calculation_3772035565420545], [region] :&#10;    MAX(&#10;        IF [year] = 2024&#10;        THEN [Calculation_3772035614969864]&#10;        END&#10;    )&#10;}' />
      </column>
      <column caption='Difference Active Routes' datatype='real' default-format='n#,##0.0;-#,##0.0' name='[Calculation_3772035622621195]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Calculation_3772035615272970] - [Calculation_3772035615125513]' />
      </column>
